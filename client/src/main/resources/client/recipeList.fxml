<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>

<HBox prefHeight="400.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.RecipeListCtrl">
   <children>
      <VBox prefHeight="400.0" prefWidth="345.0">
      
                <TableView fx:id="table" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="400.0" prefWidth="320.0">
              <columns>
                  <TableColumn fx:id="idColumn" prefWidth="39.199981689453125" text="ID" />
                  <TableColumn fx:id="nameColumn" prefWidth="179.199951171875" text="Name" />
                  <TableColumn fx:id="languageColumn" prefWidth="107.20001220703125" text="Language" />
              </columns>
          </TableView>
      </VBox>
      <VBox>
         <children>
            <ListView fx:id="Listingredients" maxHeight="-Infinity" prefHeight="350.0" prefWidth="394.0" />
            <Button fx:id="Add_Ingredients" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onMouseClicked="#AddnewIngredient" prefHeight="30.0" prefWidth="150.0" text="Add new Ingredients" translateX="100.0" translateY="10.0" />
             <Button fx:id="addButton" layoutY="15.0" mnemonicParsing="false" onAction="#addRecipeButton" prefHeight="25.0" prefWidth="84.0" text="Add Recipe" />
         </children>
      </VBox>
   </children>
</HBox>
