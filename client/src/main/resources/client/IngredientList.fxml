<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="400.0" prefWidth="600.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.IngredientList">

    <TableView fx:id="table" prefHeight="400" prefWidth="600">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="180"/>
            <TableColumn fx:id="proteinColumn" text="Protein" prefWidth="100"/>
            <TableColumn fx:id="carbsColumn" text="Carbs" prefWidth="100"/>
            <TableColumn fx:id="fatColumn" text="Fat" prefWidth="100"/>
            <TableColumn fx:id="caloriesColumn" text="Calories" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>
